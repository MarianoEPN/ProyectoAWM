  { nombre: 'Beige', hex: '#F5F5DC' },
  { nombre: 'Dorado', hex: '#FFD700' },
  { nombre: 'Rosa', hex: '#EC4899' },
  { nombre: 'Morado', hex: '#9333EA' },
