/**
 * @fileoverview Listado paginado de vehículos con filtros por texto y estado.
 * Permite navegar al formulario de creación/edición y revocar/activar vehículos.
 * @module pantallas/VehiculosLista
 */

import React, { useEffect, useState } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, FlatList, ActivityIndicator, TextInput, Alert } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { useAppData } from '../gatillos/useAppData';
import { colorHexDe } from '../utilidades/uiOptions';
import { COLORS } from '../utilidades/config';

/**
 * Pantalla de gestión de vehículos.
 * @param {Object} props
 * @param {Object} props.navigation - Navegación.
 * @returns {JSX.Element}
 */
export default function VehiculosLista({ navigation }) {
  const { 
    vehiculos, 
    vehiculosMeta, 
    vehiculosPage, 
    vehiculosLoading, 
    vehiculosError, 
    fetchVehiculos, 
    toggleVehiculoEstado 
  } = useAppData();

  const [filtroTexto, setFiltroTexto] = useState('');
  const [filtroEstado, setFiltroEstado] = useState('todos');

  /**
   * Filtra los vehículos de la página actual según texto y estado.
   * @type {Array<Object>}
   */
  const visibles = vehiculos.filter(v => {
    const t = filtroTexto.trim().toLowerCase();
    const matchesTexto = !t || v.placa.toLowerCase().includes(t) || (v.nombrePropietario || '').toLowerCase().includes(t);
    const matchesEstado = filtroEstado === 'todos' || v.estadoActivo === filtroEstado;
    return matchesTexto && matchesEstado;
  });

  const vigentesEnPagina = vehiculos.filter(v => v.estadoActivo === 'VIGENTE').length;
  const revocadosEnPagina = vehiculos.filter(v => v.estadoActivo !== 'VIGENTE').length;

  /** Carga inicial de la primera página. */
  useEffect(() => {
    fetchVehiculos(1);
  }, [fetchVehiculos]);

  /**
   * Cambia de página en el listado.
   * @param {number} page - Número de página destino.
   */
  const handlePageChange = (page) => {
    fetchVehiculos(page);
  };

  /**
   * Alterna el estado vigente/revocado de un vehículo.
   * @param {Object} v - Vehículo a modificar.
   */
  const handleToggleEstado = (v) => {
    try {
      toggleVehiculoEstado(v);
    } catch (err) {
      Alert.alert('Error', 'No se pudo actualizar el estado');
    }
  };

  if (vehiculosLoading && vehiculosPage === 1) {
    return (
      <View style={styles.loading}>
        <ActivityIndicator size="large" color={COLORS.primary} />
        <Text style={styles.loadingText}>Cargando vehículos...</Text>
      </View>
    );
  }

  return (
    <View style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.titulo}>Gestión de Vehículos</Text>
        <TouchableOpacity style={styles.btnNuevo} onPress={() => navigation.navigate('VehiculoFormulario')}>
          <Ionicons name="add" size={20} color={COLORS.white} style={{ marginRight: 6 }} />
          <Text style={styles.btnNuevoTexto}>Nuevo</Text>
        </TouchableOpacity>
      </View>

      <View style={styles.statsRow}>
        <View style={styles.stat}>
          <Text style={styles.statNumero}>{vehiculosMeta?.totalItems || '—'}</Text>
          <Text style={styles.statLabel}>Total registrados</Text>
        </View>
        <View style={styles.stat}>
          <Text style={[styles.statNumero, { color: COLORS.success }]}>{vigentesEnPagina}</Text>
          <Text style={styles.statLabel}>Vigentes (esta página)</Text>
        </View>
        <View style={styles.stat}>
          <Text style={[styles.statNumero, { color: COLORS.danger }]}>{revocadosEnPagina}</Text>
          <Text style={styles.statLabel}>Revocados (esta página)</Text>
        </View>
      </View>

      <View style={styles.searchRow}>
        <TextInput
          style={styles.searchInput}
          placeholder="Filtrar en esta página…"
          value={filtroTexto}
          onChangeText={setFiltroTexto}
        />
        <View style={styles.chips}>
          <TouchableOpacity style={[styles.chip, filtroEstado === 'todos' && styles.chipActivo]} onPress={() => setFiltroEstado('todos')}>
            <Text style={[styles.chipTexto, filtroEstado === 'todos' && styles.chipTextoActivo]}>Todos</Text>
          </TouchableOpacity>
          <TouchableOpacity style={[styles.chip, filtroEstado === 'VIGENTE' && styles.chipActivo]} onPress={() => setFiltroEstado('VIGENTE')}>
            <View style={[styles.dot, { backgroundColor: COLORS.success }]} />
            <Text style={[styles.chipTexto, filtroEstado === 'VIGENTE' && styles.chipTextoActivo]}>Vigentes</Text>
          </TouchableOpacity>
          <TouchableOpacity style={[styles.chip, filtroEstado === 'REVOCADA' && styles.chipActivo]} onPress={() => setFiltroEstado('REVOCADA')}>
            <View style={[styles.dot, { backgroundColor: COLORS.danger }]} />
            <Text style={[styles.chipTexto, filtroEstado === 'REVOCADA' && styles.chipTextoActivo]}>Revocados</Text>
          </TouchableOpacity>
        </View>
      </View>

      <Text style={styles.searchHint}>Este filtro solo busca dentro de la página cargada. Para buscar una placa específica en todo el padrón, usa el validador.</Text>

      <FlatList
        data={visibles}
        keyExtractor={item => item.idVehiculo.toString()}
        renderItem={({ item }) => (
          <TouchableOpacity style={styles.row} onPress={() => navigation.navigate('VehiculoFormulario', { item })}>
            <View style={styles.cellPlaca}>
              <Text style={styles.cellMono}>{item.placa}</Text>
            </View>
            <View style={styles.cellInfo}>
              <Text style={styles.cellModelo}>{item.modelo}</Text>
              <View style={styles.cellColorRow}>
                <View style={[styles.colorSwatch, { backgroundColor: colorHexDe(item.color) }]} />
                <Text style={styles.cellColorTexto}>{item.color}</Text>
              </View>
            </View>
            <View style={styles.cellPropietario}>
              <Text style={styles.cellPropietarioTexto}>{item.nombrePropietario || '—'}</Text>
            </View>
            <View style={styles.cellVence}>
              <Text style={styles.cellVenceTexto}>{item.fechaExpiracion}</Text>
            </View>
            <View style={styles.cellEstado}>
              {item.estadoActivo === 'VIGENTE' ? (
                <View style={styles.badgeVigente}>
                  <Ionicons name="check" size={10} color={COLORS.success} />
                  <Text style={styles.badgeTexto}>Vigente</Text>
                </View>
              ) : (
                <View style={styles.badgeRevocada}>
                  <Ionicons name="ban" size={10} color={COLORS.danger} />
                  <Text style={[styles.badgeTexto, { color: COLORS.danger }]}>{item.estadoActivo}</Text>
                </View>
              )}
            </View>
            <View style={styles.cellAcciones}>
              <TouchableOpacity onPress={e => { e.stopPropagation(); handleToggleEstado(item); }} style={styles.actionBtn}>
                <Ionicons name={item.estadoActivo === 'VIGENTE' ? 'ban' : 'rotate-clockwise'} size={18} color={COLORS.danger} />
              </TouchableOpacity>
            </View>
          </TouchableOpacity>
        )}
        contentContainerStyle={styles.listContent}
        ListEmptyComponent={
          <View style={styles.emptyState}>
            <Ionicons name={visibles.length === 0 ? 'car-off' : 'search-off'} size={64} color={COLORS.gray} />
            <Text style={styles.emptyText}>No hay vehículos que coincidan</Text>
          </View>
        }
      />

      {vehiculosMeta && vehiculosMeta.totalPages > 1 && (
        <View style={styles.pager}>
          <Text style={styles.pagerText}>
            {vehiculosMeta ? `Página ${vehiculosMeta.currentPage} de ${vehiculosMeta.totalPages} · Total ${vehiculosMeta.totalItems}` : '—'}
          </Text>
          <View style={styles.pagerButtons}>
            <TouchableOpacity
              style={[styles.pagerBtn, !vehiculosMeta?.prevPage && styles.pagerBtnDisabled]}
              onPress={() => handlePageChange(vehiculosPage - 1)}
              disabled={!vehiculosMeta?.prevPage}
            >
              <Text style={styles.pagerBtnText}>← Anterior</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[styles.pagerBtn, styles.pagerBtnActive]}>
              <Text style={[styles.pagerBtnText, { color: COLORS.white }]}>{vehiculosPage}</Text>
            </TouchableOpacity>
            <TouchableOpacity
              style={[styles.pagerBtn, !vehiculosMeta?.nextPage && styles.pagerBtnDisabled]}
              onPress={() => handlePageChange(vehiculosPage + 1)}
              disabled={!vehiculosMeta?.nextPage}
            >
              <Text style={styles.pagerBtnText}>Siguiente →</Text>
            </TouchableOpacity>
          </View>
        </View>
      )}
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: COLORS.background },
  header: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: 16, borderBottomWidth: 1, borderBottomColor: COLORS.border },
  titulo: { fontSize: 20, fontWeight: '700', color: COLORS.text },
  btnNuevo: { flexDirection: 'row', alignItems: 'center', gap: 6, paddingHorizontal: 12, paddingVertical: 8, borderRadius: 8, backgroundColor: COLORS.primary },
  btnNuevoTexto: { fontSize: 13, fontWeight: '600', color: COLORS.white },
  loading: { flex: 1, justifyContent: 'center', alignItems: 'center' },
  loadingText: { marginTop: 12, color: COLORS.gray },
  statsRow: { flexDirection: 'row', padding: 16, borderBottomWidth: 0.5, borderBottomColor: COLORS.border },
  stat: { flex: 1, paddingHorizontal: 8 },
  statNumero: { fontSize: 18, fontWeight: '700', color: COLORS.text, margin: 0 },
  statLabel: { fontSize: 10, color: COLORS.gray, marginTop: 1 },
  searchRow: { padding: 16, borderBottomWidth: 0.5, borderBottomColor: COLORS.border },
