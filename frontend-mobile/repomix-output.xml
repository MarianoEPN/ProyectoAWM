/**
 * @fileoverview Listado paginado de vendedores con filtros y acciones de revocación/reactivación.
 * @module pantallas/VendedoresLista
 */

import React, { useEffect, useState, useMemo } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, FlatList, ActivityIndicator, TextInput, Alert } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { useAppData } from '../gatillos/useAppData';
import { getInitials, getAvatarColors } from '../utilidades/uiOptions';
import { COLORS } from '../utilidades/config';
import Modal from '../componentes/Modal';

/**
 * Obtiene la fecha de hoy en formato YYYY-MM-DD.
 * @returns {string}
 */
const getHoy = () => new Date().toISOString().split('T')[0];

/**
 * Obtiene la fecha de hoy + 1 año en formato YYYY-MM-DD.
 * @returns {string}
 */
const getHoyMasUnAno = () => {
  const d = new Date();
  d.setFullYear(d.getFullYear() + 1);
  return d.toISOString().split('T')[0];
};

/**
 * Pantalla de gestión de vendedores.
 * @param {Object} props
 * @param {Object} props.navigation - Navegación.
 * @returns {JSX.Element}
 */
export default function VendedoresLista({ navigation }) {
  const { 
    vendedores, 
    vendedoresMeta, 
    vendedoresPage, 
    vendedoresLoading, 
    fetchVendedores, 
    obtenerVendedor, 
    revocarVendedor,
    updateVendedor
  } = useAppData();

  const [filtroTexto, setFiltroTexto] = useState('');
  const [filtroEstado, setFiltroEstado] = useState('todos');
  const [cargandoDetalle, setCargandoDetalle] = useState(false);

  // Modal de reactivación
  const [showReactivarModal, setShowReactivarModal] = useState(false);
  const [vendedorAReactivar, setVendedorAReactivar] = useState(null);
  const [nuevaFechaEmision, setNuevaFechaEmision] = useState(getHoy());
  const [nuevaFechaExpiracion, setNuevaFechaExpiracion] = useState(getHoyMasUnAno());

  /** Vendedores filtrados por texto y estado. */
  const visibles = useMemo(() => {
    return vendedores.filter((v) => {
      const t = filtroTexto.trim().toLowerCase();
      const matchesTexto = !t || v.cedula.toLowerCase().includes(t) || v.nombre.toLowerCase().includes(t);
      const matchesEstado = filtroEstado === 'todos' || v.estadoActivo === filtroEstado;
      return matchesTexto && matchesEstado;
    });
  }, [vendedores, filtroTexto, filtroEstado]);

  const vigentesEnPagina = vendedores.filter((v) => v.estadoActivo === 'VIGENTE').length;
  const otrosEnPagina = vendedores.filter((v) => v.estadoActivo !== 'VIGENTE').length;

  /** Carga inicial. */
  useEffect(() => {
    fetchVendedores(1);
  }, [fetchVendedores]);

  /**
   * Navega al formulario de edición con el detalle completo.
   * @async
   * @param {Object} v - Vendedor seleccionado.
   */
  const handleEditar = async (v) => {
    setCargandoDetalle(true);
    try {
      const detalle = await obtenerVendedor(v.idVendedor);
      navigation.navigate('VendedorFormulario', { item: detalle });
    } catch (err) {
      Alert.alert('Error', 'No se pudo cargar el detalle del vendedor');
    } finally {
      setCargandoDetalle(false);
    }
  };

  /**
   * Revoca la autorización de un vendedor.
   * @async
   * @param {Object} v - Vendedor a revocar.
   */
  const handleRevocar = async (v) => {
    setCargandoDetalle(true);
    try {
      const detalle = await obtenerVendedor(v.idVendedor);
      await revocarVendedor(detalle);
    } catch (err) {
      Alert.alert('Error', 'No se pudo revocar la autorización');
    } finally {
      setCargandoDetalle(false);
    }
  };

  /**
   * Abre el modal para reactivar un vendedor revocado.
   * @param {Object} v - Vendedor a reactivar.
   */
  const handleAbrirReactivar = (v) => {
    setVendedorAReactivar(v);
    setNuevaFechaEmision(getHoy());
    setNuevaFechaExpiracion(getHoyMasUnAno());
    setShowReactivarModal(true);
  };

  /**
   * Confirma la reactivación del vendedor con nuevas fechas.
   * @async
   */
  const handleConfirmarReactivacion = async () => {
    if (!vendedorAReactivar) return;
    if (new Date(nuevaFechaExpiracion) < new Date(nuevaFechaEmision)) {
      Alert.alert('Error', 'La fecha de expiración no puede ser anterior a la de emisión.');
      return;
    }
    try {
      setCargandoDetalle(true);
      await updateVendedor(vendedorAReactivar.idVendedor, {
        cedula: vendedorAReactivar.cedula,
        nombre: vendedorAReactivar.nombre,
        foto: vendedorAReactivar.foto,
        nResolucion: vendedorAReactivar.nResolucion,
        fechaEmision: nuevaFechaEmision,
        fechaExpiracion: nuevaFechaExpiracion,
        estadoActivo: 'VIGENTE',
        idHabitante: vendedorAReactivar.idHabitante,
        categoriasIds: (vendedorAReactivar.categorias || []).map((c) => c.idCategoria),
      });
      setShowReactivarModal(false);
      setVendedorAReactivar(null);
    } catch (err) {
      Alert.alert('Error', 'No se pudo reactivar el vendedor');
    } finally {
      setCargandoDetalle(false);
    }
  };

  if (vendedoresLoading && vendedoresPage === 1) {
    return (
      <View style={styles.loading}>
        <ActivityIndicator size="large" color={COLORS.primary} />
        <Text style={styles.loadingText}>Cargando vendedores...</Text>
      </View>
    );
  }

  return (
    <View style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.titulo}>Gestión de Vendedores</Text>
        <TouchableOpacity style={styles.btnNuevo} onPress={() => navigation.navigate('VendedorFormulario')}>
          <Ionicons name="add" size={20} color={COLORS.white} style={{ marginRight: 6 }} />
          <Text style={styles.btnNuevoTexto}>Nuevo</Text>
        </TouchableOpacity>
      </View>

      <View style={styles.searchRow}>
        <TextInput
          style={styles.searchInput}
          placeholder="Filtrar por cédula o nombre en esta página…"
          value={filtroTexto}
          onChangeText={setFiltroTexto}
        />
      </View>

      <View style={styles.statsRow}>
        <View style={styles.stat}>
          <Text style={styles.statNumero}>{vendedoresMeta?.totalItems || '—'}</Text>
          <Text style={styles.statLabel}>Total registrados</Text>
        </View>
        <View style={styles.stat}>
          <Text style={[styles.statNumero, { color: COLORS.success }]}>{vigentesEnPagina}</Text>
          <Text style={styles.statLabel}>Vigentes (esta página)</Text>
        </View>
        <View style={styles.stat}>
          <Text style={[styles.statNumero, { color: COLORS.danger }]}>{otrosEnPagina}</Text>
          <Text style={styles.statLabel}>No vigentes (esta página)</Text>
        </View>
      </View>

      <View style={styles.filters}>
        <Text style={styles.filterLabel}>Filtrar:</Text>
        <TouchableOpacity style={[styles.chip, filtroEstado === 'todos' && styles.chipActivo]} onPress={() => setFiltroEstado('todos')}>
          <Text style={[styles.chipTexto, filtroEstado === 'todos' && styles.chipTextoActivo]}>Todos</Text>
        </TouchableOpacity>
        <TouchableOpacity style={[styles.chip, filtroEstado === 'VIGENTE' && styles.chipActivo]} onPress={() => setFiltroEstado('VIGENTE')}>
          <View style={[styles.dot, { backgroundColor: COLORS.success }]} />
          <Text style={[styles.chipTexto, filtroEstado === 'VIGENTE' && styles.chipTextoActivo]}>Vigentes</Text>
        </TouchableOpacity>
        <TouchableOpacity style={[styles.chip, filtroEstado === 'REVOCADA' && styles.chipActivo]} onPress={() => setFiltroEstado('REVOCADA')}>
          <View style={[styles.dot, { backgroundColor: COLORS.danger }]} />
          <Text style={[styles.chipTexto, filtroEstado === 'REVOCADA' && styles.chipTextoActivo]}>Revocados</Text>
        </TouchableOpacity>
      </View>

      <Text style={styles.searchHint}>Este filtro solo busca dentro de la página cargada. Para verificar una cédula/resolución/QR específico en todo el sistema, usa el validador.</Text>

      <FlatList
        data={visibles}
        keyExtractor={(item) => item.idVendedor.toString()}
        renderItem={({ item }) => (
          <View style={styles.card}>
            <View style={styles.cardTop}>
              <View style={[styles.avatar, { backgroundColor: getAvatarColors(item.nombre).bg }]}>
                <Text style={[styles.avatarText, { color: getAvatarColors(item.nombre).color }]}>{getInitials(item.nombre)}</Text>
              </View>
              <View style={styles.cardTopInfo}>
                <Text style={styles.nombre}>{item.nombre}</Text>
                <View style={styles.categoriasRow}>
                  {(item.categorias || []).map((c) => (
                    <View key={c.idCategoria} style={styles.badgeCategoria}>
                      <Text style={styles.badgeCategoriaTexto}>{c.nombre}</Text>
                    </View>
                  ))}
                </View>
                <Text style={styles.resolucion}>Resol. {item.nResolucion}</Text>
              </View>
              <View style={styles.cardTopEstado}>
                {item.estadoActivo === 'VIGENTE' ? (
                  <View style={styles.badgeVigente}>
                    <Ionicons name="check" size={10} color={COLORS.success} />
                    <Text style={styles.badgeTexto}>Vigente</Text>
                  </View>
                ) : (
                  <View style={styles.badgeRevoca}>
                    <Ionicons name="alert-circle" size={10} color={COLORS.danger} />
                    <Text style={[styles.badgeTexto, { color: COLORS.danger }]}>{item.estadoActivo}</Text>
                  </View>
                )}
              </View>
            </View>

            <View style={styles.cardBottom}>
              <View style={styles.metaRow}>
                <Ionicons name="card" size={12} color={COLORS.gray} />
                <Text style={styles.metaText}>Cédula: {item.cedula}</Text>
              </View>
              <View style={styles.metaRow}>
                <Ionicons name="calendar" size={12} color={COLORS.gray} />
                <Text style={styles.metaText}>Vence: {item.fechaExpiracion || '—'}</Text>
              </View>
              <View style={styles.actionsRow}>
                <TouchableOpacity onPress={() => handleEditar(item)} style={styles.actionBtn}>
                  <Ionicons name="create" size={18} color={COLORS.primary} />
                  <Text style={styles.actionText}>Editar</Text>
                </TouchableOpacity>
                {item.estadoActivo === 'VIGENTE' ? (
                  <TouchableOpacity onPress={() => handleRevocar(item)} style={styles.actionBtn}>
                    <Ionicons name="ban" size={18} color={COLORS.danger} />
                    <Text style={[styles.actionText, { color: COLORS.danger }]}>Revocar</Text>
                  </TouchableOpacity>
                ) : (
                  <TouchableOpacity onPress={() => handleAbrirReactivar(item)} style={styles.actionBtn}>
                    <Ionicons name="refresh" size={18} color={COLORS.success} />
                    <Text style={[styles.actionText, { color: COLORS.success }]}>Reactivar</Text>
                  </TouchableOpacity>
                )}
              </View>
            </View>
          </View>
        )}
        contentContainerStyle={styles.listContent}
        ListEmptyComponent={
          <View style={styles.emptyState}>
            <Ionicons name="people-off" size={64} color={COLORS.gray} />
            <Text style={styles.emptyText}>No hay vendedores que coincidan</Text>
          </View>
        }
      />

      {vendedoresMeta && vendedoresMeta.totalPages > 1 && (
        <View style={styles.pager}>
          <Text style={styles.pagerText}>
            {vendedoresMeta ? `Página ${vendedoresMeta.currentPage} de ${vendedoresMeta.totalPages} · Total ${vendedoresMeta.totalItems}` : '—'}
          </Text>
          <View style={styles.pagerButtons}>
            <TouchableOpacity style={[styles.pagerBtn, !vendedoresMeta?.prevPage && styles.pagerBtnDisabled]} onPress={() => fetchVendedores(vendedoresPage - 1)} disabled={!vendedoresMeta?.prevPage}>
              <Text style={styles.pagerBtnText}>← Anterior</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[styles.pagerBtn, styles.pagerBtnActive]}>
              <Text style={[styles.pagerBtnText, { color: COLORS.white }]}>{vendedoresPage}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[styles.pagerBtn, !vendedoresMeta?.nextPage && styles.pagerBtnDisabled]} onPress={() => fetchVendedores(vendedoresPage + 1)} disabled={!vendedoresMeta?.nextPage}>
              <Text style={styles.pagerBtnText}>Siguiente →</Text>
            </TouchableOpacity>
          </View>
        </View>
      )}

      {cargandoDetalle ? (
        <View style={styles.loadingOverlay}>
          <Text style={styles.loadingOverlayText}>Cargando detalle…</Text>
        </View>
      ) : null}

      {/* Modal de Reactivación */}
      <Modal visible={showReactivarModal} transparent={true} onRequestClose={() => setShowReactivarModal(false)}>
        <View style={styles.modalOverlay}>
          <View style={styles.modalBox}>
            <Text style={styles.modalTitle}>Reactivar Vendedor</Text>
            <Text style={styles.modalSubtitle}>Define las nuevas fechas de la licencia</Text>

            <View style={styles.modalField}>
              <Text style={styles.modalLabel}>Fecha de emisión *</Text>
              <TextInput
                style={styles.modalInput}
                value={nuevaFechaEmision}
                onChangeText={(text) => {
                  setNuevaFechaEmision(text);
                  // Auto-ajustar vencimiento a +1 año si aún no ha sido tocado manualmente o siempre
                  const d = new Date(text);
                  if (!isNaN(d.getTime())) {
                    d.setFullYear(d.getFullYear() + 1);
                    setNuevaFechaExpiracion(d.toISOString().split('T')[0]);
                  }
                }}
                placeholder="YYYY-MM-DD"
              />
            </View>

            <View style={styles.modalField}>
              <Text style={styles.modalLabel}>Fecha de expiración *</Text>
              <TextInput
                style={styles.modalInput}
                value={nuevaFechaExpiracion}
                onChangeText={setNuevaFechaExpiracion}
                placeholder="YYYY-MM-DD"
              />
            </View>

            <View style={styles.modalActions}>
              <TouchableOpacity style={styles.btnModalSecundario} onPress={() => setShowReactivarModal(false)}>
                <Text style={styles.btnModalSecundarioTexto}>Cancelar</Text>
              </TouchableOpacity>
              <TouchableOpacity style={styles.btnModalPrimario} onPress={handleConfirmarReactivacion}>
                <Text style={styles.btnModalPrimarioTexto}>Reactivar</Text>
              </TouchableOpacity>
            </View>
          </View>
        </View>
      </Modal>
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: COLORS.background },
  header: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: 16, borderBottomWidth: 1, borderBottomColor: COLORS.border },
