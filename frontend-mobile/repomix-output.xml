/**
 * @fileoverview Formulario de creación y edición de vendedores.
 * @module pantallas/VendedorFormulario
 */

import React, { useState } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, ScrollView, TextInput, Alert, KeyboardAvoidingView, Platform } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { useAppData } from '../gatillos/useAppData';
import { COLORS } from '../utilidades/config';

/**
 * Obtiene la fecha de hoy en formato YYYY-MM-DD.
 * @returns {string}
 */
const getHoy = () => new Date().toISOString().split('T')[0];

/**
 * Obtiene la fecha de hoy + 1 año en formato YYYY-MM-DD.
 * @returns {string}
 */
const getHoyMasUnAno = () => {
  const d = new Date();
  d.setFullYear(d.getFullYear() + 1);
  return d.toISOString().split('T')[0];
};

/**
 * Pantalla de formulario para vendedores.
 * @param {Object} props
 * @param {Object} props.route - Contiene `item` en modo edición.
 * @param {Object} props.navigation - Navegación.
 * @returns {JSX.Element}
 */
export default function VendedorFormulario({ route, navigation }) {
  const { addVendedor, updateVendedor, categorias } = useAppData();
  const { item } = route.params || {};
  const editando = !!item;

  const [cedula, setCedula] = useState(item?.cedula || '');
  const [nombre, setNombre] = useState(item?.nombre || '');
  const [nResolucion, setNResolucion] = useState(item?.nResolucion || '');
  const [fechaEmision, setFechaEmision] = useState(item?.fechaEmision || getHoy());
  const [fechaExpiracion, setFechaExpiracion] = useState(item?.fechaExpiracion || getHoyMasUnAno());
  const [idHabitante, setIdHabitante] = useState(item?.idHabitante ?? '');
  const [categoriasIds, setCategoriasIds] = useState((item?.categorias || []).map((c) => c.idCategoria));
  const [error, setError] = useState('');
  const [guardando, setGuardando] = useState(false);

  /**
   * Activa o desactiva una categoría en la selección múltiple.
   * @param {number} id - ID de la categoría.
   */
  const toggleCategoria = (id) => {
    setCategoriasIds((prev) => (prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]));
  };

  /**
   * Valida campos y envía el payload al backend.
   * @async
   */
  const handleSubmit = async () => {
    if (!cedula.trim() || !nombre.trim() || !nResolucion.trim() || !fechaEmision || !fechaExpiracion) {
      setError('Completa cédula, nombre, resolución y ambas fechas.');
      return;
    }
    if (!/^\d{10}$/.test(cedula.trim())) {
      setError('La cédula debe tener 10 dígitos.');
      return;
    }
    if (categoriasIds.length === 0) {
      setError('Selecciona al menos una categoría.');
      return;
    }
    if (new Date(fechaEmision) > new Date(getHoy())) {
      setError('La fecha de emisión no puede ser posterior a hoy.');
      return;
    }
    if (new Date(fechaExpiracion) < new Date(fechaEmision)) {
      setError('La fecha de expiración no puede ser anterior a la de emisión.');
      return;
    }
    setGuardando(true);
    setError('');
    try {
      const payload = {
        cedula: cedula.trim(),
        nombre: nombre.trim(),
        foto: item?.foto || 'Pendiente de definición de infraestructura',
        nResolucion: nResolucion.trim(),
        fechaEmision,
        fechaExpiracion,
        estadoActivo: editando ? (item?.estadoActivo || 'VIGENTE') : 'VIGENTE',
        idHabitante: idHabitante ? Number(idHabitante) : null,
        categoriasIds,
      };
      if (editando) {
        await updateVendedor(item.idVendedor, payload);
      } else {
        await addVendedor(payload);
      }
      navigation.goBack();
    } catch (err) {
      setError('Error al guardar el vendedor');
    } finally {
      setGuardando(false);
    }
  };

  return (
    <KeyboardAvoidingView behavior={Platform.OS === 'ios' ? 'padding' : 'height'} style={styles.container}>
      <View style={styles.header}>
        <TouchableOpacity onPress={() => navigation.goBack()} style={styles.backBtn}>
          <Ionicons name="chevron-back" size={24} color={COLORS.text} />
        </TouchableOpacity>
        <Text style={styles.headerTitulo}>{editando ? 'Editar Vendedor' : 'Nuevo Vendedor'}</Text>
        <View style={{ width: 44 }} />
      </View>

      <ScrollView contentContainerStyle={styles.scrollContent} keyboardShouldPersistTaps="handled">
        <View style={styles.form}>
          <View style={styles.campo}>
            <Text style={styles.label}>Cédula *</Text>
            <TextInput
              style={styles.input}
              placeholder="10 dígitos"
              value={cedula}
              onChangeText={setCedula}
              keyboardType="numeric"
              maxLength={10}
            />
          </View>

          <View style={styles.campo}>
            <Text style={styles.label}>Nombre completo *</Text>
            <TextInput
              style={styles.input}
              placeholder="Nombre y apellido"
              value={nombre}
              onChangeText={setNombre}
            />
          </View>

          <View style={styles.campo}>
            <Text style={styles.label}>Categorías * (una o varias)</Text>
            <View style={styles.categoriaChips}>
              {categorias.map((c) => (
                <TouchableOpacity
                  key={c.idCategoria}
                  style={[
                    styles.categoriaChip,
                    categoriasIds.includes(c.idCategoria) && styles.categoriaChipActivo,
                  ]}
                  onPress={() => toggleCategoria(c.idCategoria)}
                >
                  <Text style={[styles.categoriaChipTexto, categoriasIds.includes(c.idCategoria) && styles.categoriaChipTextoActivo]}>{c.nombre}</Text>
                </TouchableOpacity>
              ))}
            </View>
            {categorias.length === 0 ? <Text style={styles.noCategorias}>No hay categorías cargadas todavía.</Text> : null}
          </View>

          <View style={styles.campo}>
            <Text style={styles.label}>N.° de resolución *</Text>
            <TextInput
              style={styles.input}
              placeholder="Ej. AXBXCX"
              value={nResolucion}
              onChangeText={setNResolucion}
            />
          </View>

          <View style={styles.filaFechas}>
            <View style={styles.campo}>
              <Text style={styles.label}>Fecha de emisión *</Text>
              <TextInput
                style={styles.input}
                placeholder="YYYY-MM-DD"
                value={fechaEmision}
                onChangeText={(text) => {
                  setFechaEmision(text);
                  const d = new Date(text);
                  if (!isNaN(d.getTime())) {
                    d.setFullYear(d.getFullYear() + 1);
                    setFechaExpiracion(d.toISOString().split('T')[0]);
                  }
                }}
              />
            </View>
            <View style={styles.campo}>
              <Text style={styles.label}>Fecha de expiración *</Text>
              <TextInput
                style={styles.input}
                placeholder="YYYY-MM-DD"
                value={fechaExpiracion}
                onChangeText={setFechaExpiracion}
              />
            </View>
          </View>

          <View style={styles.campo}>
            <Text style={styles.label}>ID de habitante (opcional)</Text>
            <TextInput
              style={styles.input}
              placeholder="Ej. 4050"
              value={String(idHabitante)}
              onChangeText={setIdHabitante}
              keyboardType="numeric"
            />
          </View>

          {error ? <Text style={styles.error}>{error}</Text> : null}

          <View style={styles.btnContainer}>
            <TouchableOpacity style={styles.btnSecundario} onPress={() => navigation.goBack()}>
              <Text style={styles.btnSecundarioTexto}>Cancelar</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[styles.btnPrimario, guardando && styles.btnDisabled]} onPress={handleSubmit} disabled={guardando}>
              <Text style={styles.btnPrimarioTexto}>{guardando ? 'Guardando…' : (editando ? 'Actualizar' : 'Crear')}</Text>
            </TouchableOpacity>
          </View>
        </View>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: COLORS.background },
  header: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: 16, borderBottomWidth: 1, borderBottomColor: COLORS.border },
  backBtn: { padding: 4 },
  headerTitulo: { fontSize: 18, fontWeight: '700', color: COLORS.text, flex: 1, textAlign: 'center' },
  scrollContent: { padding: 16, paddingBottom: 40 },
  form: { gap: 16 },
  campo: { gap: 6 },
  label: { fontSize: 12, fontWeight: '500', color: '#666' },
  input: { height: 48, borderWidth: 1, borderColor: '#d1c9b8', borderRadius: 8, paddingHorizontal: 14, fontSize: 15, backgroundColor: '#faf8f4', color: '#333' },
  categoriaChips: { flexDirection: 'row', flexWrap: 'wrap', gap: 6 },
  categoriaChip: { flexDirection: 'row', alignItems: 'center', gap: 5, paddingHorizontal: 9, paddingVertical: 4, borderWidth: 0.5, borderColor: '#d1c9b8', borderRadius: 20, backgroundColor: COLORS.background },
  categoriaChipActivo: { backgroundColor: COLORS.primary, borderColor: COLORS.primary },
  categoriaChipTexto: { fontSize: 11, color: '#666' },
  categoriaChipTextoActivo: { color: COLORS.white },
  noCategorias: { fontSize: 11, color: COLORS.gray },
  filaFechas: { flexDirection: 'row', gap: 12 },
  error: { fontSize: 12, color: COLORS.danger, textAlign: 'center' },
  btnContainer: { flexDirection: 'row', justifyContent: 'center', marginTop: 24, gap: 12 },
  btnPrimario: { flex: 1, height: 48, borderRadius: 8, backgroundColor: COLORS.primary, justifyContent: 'center', alignItems: 'center', paddingHorizontal: 24 },
  btnPrimarioTexto: { fontSize: 15, fontWeight: '600', color: COLORS.white },
  btnSecundario: { flex: 1, height: 48, borderRadius: 8, backgroundColor: COLORS.white, borderWidth: 1, borderColor: '#d1c9b8', justifyContent: 'center', alignItems: 'center', paddingHorizontal: 24 },
  btnSecundarioTexto: { fontSize: 15, fontWeight: '600', color: '#666' },
