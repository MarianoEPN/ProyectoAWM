/**
 * @fileoverview Pantalla de detalle de un vehículo.
 * Muestra información completa: placa, modelo, color, propietario, vigencia y QR.
 * @module pantallas/VehiculoDetalle
 */

import React, { useEffect, useState } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, ActivityIndicator, Alert, KeyboardAvoidingView, Platform, ScrollView } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { useAppData } from '../gatillos/useAppData';
import { colorHexDe } from '../utilidades/uiOptions';
import { COLORS } from '../utilidades/config';

/**
 * Pantalla de detalle de vehículo.
 * @param {Object} props
 * @param {Object} props.route - Contiene `item` con los datos iniciales.
 * @param {Object} props.navigation - Navegación.
 * @returns {JSX.Element}
 */
export default function VehiculoDetalle({ route, navigation }) {
  const { obtenerVehiculo } = useAppData();
  const { item } = route.params || {};
  const [vehiculo, setVehiculo] = useState(item);
  const [cargando, setCargando] = useState(false);

  /** Si el item no trae códigoQR, carga el detalle completo desde el servidor. */
  useEffect(() => {
    if (item && !item.codigoQr) {
      cargarDetalle();
    }
  }, [item]);

  /**
   * Obtiene el detalle completo del vehículo.
   * @async
   */
  const cargarDetalle = async () => {
    if (!item) return;
    setCargando(true);
    try {
      const detalle = await obtenerVehiculo(item.idVehiculo);
      setVehiculo(detalle);
    } catch (err) {
      Alert.alert('Error', 'No se pudo cargar el detalle');
    } finally {
      setCargando(false);
    }
  };

  if (cargando) {
    return (
      <View style={styles.loading}>
        <ActivityIndicator size="large" color={COLORS.primary} />
      </View>
    );
  }

  if (!vehiculo) {
    return (
      <View style={styles.empty}>
        <Text style={styles.emptyText}>No se pudo cargar el vehículo</Text>
      </View>
    );
  }

  const esVigente = vehiculo.estadoActivo === 'VIGENTE';

  return (
    <KeyboardAvoidingView behavior={Platform.OS === 'ios' ? 'padding' : 'height'} style={styles.container}>
      <View style={styles.header}>
        <TouchableOpacity onPress={() => navigation.goBack()} style={styles.backBtn}>
          <Ionicons name="chevron-back" size={24} color={COLORS.text} />
        </TouchableOpacity>
        <Text style={styles.headerTitulo}>Detalle del Vehículo</Text>
        <View style={{ width: 44 }} />
      </View>

      <ScrollView contentContainerStyle={styles.scrollContent}>
        <View style={styles.card}>
          <View style={styles.cardHeader}>
            <View style={styles.vehicleIcon}>
              <Ionicons name="car" size={32} color={colorHexDe(vehiculo.color)} />
            </View>
            <View style={styles.vehicleTitleContainer}>
              <Text style={styles.vehicleTitle}>{vehiculo.marca} {vehiculo.modelo}</Text>
              <Text style={styles.vehicleSubtitle}>{vehiculo.placa}</Text>
            </View>
            <View style={[styles.statusBadge, { backgroundColor: esVigente ? '#d1fae5' : '#fee2e2' }]}>
              <Text style={[styles.statusText, { color: esVigente ? COLORS.success : COLORS.danger }]}>
