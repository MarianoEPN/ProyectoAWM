/**
 * @fileoverview Formulario de creación y edición de vehículos.
 * @module pantallas/VehiculoFormulario
 */

import React, { useState } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, ScrollView, TextInput, Alert, KeyboardAvoidingView, Platform } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { useAppData } from '../gatillos/useAppData';
import { vehiculoColores } from '../utilidades/uiOptions';
import { COLORS } from '../utilidades/config';

/**
 * Obtiene la fecha de hoy en formato YYYY-MM-DD.
 * @returns {string}
 */
const getHoy = () => new Date().toISOString().split('T')[0];

/**
 * Obtiene la fecha de hoy + 1 año en formato YYYY-MM-DD.
 * @returns {string}
 */
const getHoyMasUnAno = () => {
  const d = new Date();
  d.setFullYear(d.getFullYear() + 1);
  return d.toISOString().split('T')[0];
};

/**
 * Pantalla de formulario para vehículos.
 * @param {Object} props
 * @param {Object} props.route - Contiene `item` en modo edición.
 * @param {Object} props.navigation - Navegación.
 * @returns {JSX.Element}
 */
export default function VehiculoFormulario({ route, navigation }) {
  const { addVehiculo, updateVehiculo } = useAppData();
  const { item } = route.params || {};
  const editando = !!item;

  const [placa, setPlaca] = useState(item?.placa || '');
  const [modelo, setModelo] = useState(item?.modelo || '');
  const [color, setColor] = useState(item?.color || vehiculoColores[0].nombre);
  const [idHabitante, setIdHabitante] = useState(item?.idHabitante ?? '');
  const [fechaEmision, setFechaEmision] = useState(item?.fechaEmision || getHoy());
  const [fechaExpiracion, setFechaExpiracion] = useState(item?.fechaExpiracion || getHoyMasUnAno());
  const [error, setError] = useState('');
  const [guardando, setGuardando] = useState(false);

  /**
   * Valida y envía el formulario.
   * @async
   */
  const handleSubmit = async () => {
    if (!placa.trim() || !modelo.trim() || !idHabitante || !fechaEmision || !fechaExpiracion) {
      setError('Completa placa, modelo, habitante y ambas fechas.');
      return;
    }
    if (new Date(fechaEmision) > new Date(getHoy())) {
      setError('La fecha de emisión no puede ser posterior a hoy.');
      return;
    }
    if (new Date(fechaExpiracion) < new Date(fechaEmision)) {
      setError('La fecha de expiración no puede ser anterior a la de emisión.');
      return;
    }
    setGuardando(true);
    setError('');
    try {
      const payload = {
        placa: placa.trim().toUpperCase(),
        modelo: modelo.trim(),
        color,
        idHabitante: Number(idHabitante),
        fechaEmision,
        fechaExpiracion,
        estadoActivo: editando ? (item.estadoActivo || 'VIGENTE') : 'VIGENTE',
      };
      if (editando) {
        await updateVehiculo(item.idVehiculo, payload);
      } else {
        await addVehiculo(payload);
      }
      navigation.goBack();
    } catch (err) {
      setError('Error al guardar el vehículo');
    } finally {
      setGuardando(false);
    }
  };

  return (
    <KeyboardAvoidingView behavior={Platform.OS === 'ios' ? 'padding' : 'height'} style={styles.container}>
      <View style={styles.header}>
        <TouchableOpacity onPress={() => navigation.goBack()} style={styles.backBtn}>
          <Ionicons name="chevron-back" size={24} color={COLORS.text} />
        </TouchableOpacity>
        <Text style={styles.headerTitulo}>{editando ? 'Editar Vehículo' : 'Nuevo Vehículo'}</Text>
        <View style={{ width: 44 }} />
      </View>

      <ScrollView contentContainerStyle={styles.scrollContent} keyboardShouldPersistTaps="handled">
        <View style={styles.form}>
          <View style={styles.campo}>
            <Text style={styles.label}>Placa *</Text>
            <TextInput
              style={styles.input}
              placeholder="Ej. ABC-1234"
              value={placa}
              onChangeText={setPlaca}
              autoCapitalize="characters"
            />
          </View>

          <View style={styles.campo}>
            <Text style={styles.label}>Modelo *</Text>
            <TextInput
              style={styles.input}
              placeholder="Ej. Toyota Hilux"
              value={modelo}
              onChangeText={setModelo}
            />
          </View>

          <View style={styles.campo}>
            <Text style={styles.label}>ID Habitante (legacy) *</Text>
            <TextInput
              style={styles.input}
              placeholder="Ej. 4050"
              value={String(idHabitante)}
              onChangeText={setIdHabitante}
              keyboardType="numeric"
            />
          </View>

          <View style={styles.campo}>
            <Text style={styles.label}>Color</Text>
            <View style={styles.colorSelector}>
              {vehiculoColores.map(c => (
                <TouchableOpacity
                  key={c.nombre}
                  style={[
                    styles.colorOption,
                    color === c.nombre && styles.colorOptionActivo,
                    { backgroundColor: c.hex }
                  ]}
                  onPress={() => setColor(c.nombre)}
                >
                  {color === c.nombre && (
                    <Ionicons name="check" size={20} color={COLORS.white} />
                  )}
                </TouchableOpacity>
              ))}
            </View>
          </View>

          <View style={styles.filaFechas}>
            <View style={styles.campo}>
              <Text style={styles.label}>Fecha Emisión *</Text>
              <TextInput
                style={styles.input}
                placeholder="YYYY-MM-DD"
                value={fechaEmision}
                onChangeText={(text) => {
                  setFechaEmision(text);
                  const d = new Date(text);
                  if (!isNaN(d.getTime())) {
                    d.setFullYear(d.getFullYear() + 1);
                    setFechaExpiracion(d.toISOString().split('T')[0]);
                  }
                }}
              />
            </View>
            <View style={styles.campo}>
              <Text style={styles.label}>Fecha Expiración *</Text>
              <TextInput
                style={styles.input}
                placeholder="YYYY-MM-DD"
                value={fechaExpiracion}
                onChangeText={setFechaExpiracion}
              />
            </View>
          </View>

          {error ? <Text style={styles.error}>{error}</Text> : null}

          <View style={styles.btnContainer}>
            <TouchableOpacity style={styles.btnSecundario} onPress={() => navigation.goBack()}>
              <Text style={styles.btnSecundarioTexto}>Cancelar</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[styles.btnPrimario, guardando && styles.btnDisabled]} onPress={handleSubmit} disabled={guardando}>
              <Text style={styles.btnPrimarioTexto}>{guardando ? 'Guardando…' : (editando ? 'Actualizar' : 'Crear')}</Text>
            </TouchableOpacity>
          </View>
        </View>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: COLORS.background },
  header: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: 16, borderBottomWidth: 1, borderBottomColor: COLORS.border },
  backBtn: { padding: 4 },
  headerTitulo: { fontSize: 18, fontWeight: '700', color: COLORS.text, flex: 1, textAlign: 'center' },
  scrollContent: { padding: 16, paddingBottom: 40 },
  form: { gap: 16 },
  campo: { gap: 6 },
  label: { fontSize: 12, fontWeight: '500', color: '#666' },
  input: { height: 48, borderWidth: 1, borderColor: '#d1c9b8', borderRadius: 8, paddingHorizontal: 14, fontSize: 15, backgroundColor: '#faf8f4', color: '#333' },
  colorSelector: { flexDirection: 'row', flexWrap: 'wrap', gap: 8 },
  colorOption: { width: 40, height: 40, borderRadius: 20, borderWidth: 2, borderColor: 'transparent', justifyContent: 'center', alignItems: 'center' },
  colorOptionActivo: { borderColor: COLORS.white, borderWidth: 3 },
  filaFechas: { flexDirection: 'row', gap: 12 },
  error: { fontSize: 12, color: COLORS.danger, textAlign: 'center' },
  btnContainer: { flexDirection: 'row', justifyContent: 'center', marginTop: 24, gap: 12 },
  btnPrimario: { flex: 1, height: 48, borderRadius: 8, backgroundColor: COLORS.primary, justifyContent: 'center', alignItems: 'center', paddingHorizontal: 24 },
  btnPrimarioTexto: { fontSize: 15, fontWeight: '600', color: COLORS.white },
  btnSecundario: { flex: 1, height: 48, borderRadius: 8, backgroundColor: COLORS.white, borderWidth: 1, borderColor: '#d1c9b8', justifyContent: 'center', alignItems: 'center', paddingHorizontal: 24 },
  btnSecundarioTexto: { fontSize: 15, fontWeight: '600', color: '#666' },
  btnDisabled: { opacity: 0.6 },
});
</file>

