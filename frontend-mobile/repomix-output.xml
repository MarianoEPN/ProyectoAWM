                <Text style={styles.detailLabel}>Propietario</Text>
                <Text style={styles.detailValue}>{vehiculo.nombrePropietario || '—'}</Text>
              </View>
            </View>
            <View style={styles.detailItem}>
              <Ionicons name="home" size={20} color={COLORS.gray} style={styles.detailIcon} />
