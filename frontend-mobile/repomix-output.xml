/**
 * @fileoverview Pantalla de validación de vendedores por QR o búsqueda manual.
 * Incluye escaneo de códigos QR mediante expo-camera.
 * @module pantallas/ValidarVendedor
 */
import { useAuth } from '../gatillos/useAuth';
import React, { useState, useEffect } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, ActivityIndicator, Alert, KeyboardAvoidingView, Platform, ScrollView, TextInput } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { CameraView, Camera } from 'expo-camera';
import { useAppData } from '../gatillos/useAppData';
import { vendedoresApi, getErrorMessage } from '../servicios/api';
import { getInitials, getAvatarColors } from '../utilidades/uiOptions';
import { COLORS } from '../utilidades/config';
import Modal from '../componentes/Modal';

/**
 * Pantalla de validación de vendedores.
 * @param {Object} props
 * @param {Object} props.navigation - Navegación.
 * @returns {JSX.Element}
 */
export default function ValidarVendedor({ navigation }) {
  const { validarVendedor } = useAppData();
  const { clearAuth } = useAuth();
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedVendedor, setSelectedVendedor] = useState(null);
  const [showValidationModal, setShowValidationModal] = useState(false);
  const [validationData, setValidationData] = useState({ estado: 'validado', observaciones: '' });
  const [validationLoading, setValidationLoading] = useState(false);
  const [historial, setHistorial] = useState([]);
  const [pendientes, setPendientes] = useState([]);
  const [loadingPendientes, setLoadingPendientes] = useState(false);
  const [escaneando, setEscaneando] = useState(false);
  const [hasCameraPermission, setHasCameraPermission] = useState(null);
  const [tipoBusqueda, setTipoBusqueda] = useState('cedula');

  /**
   * Solicita permiso de cámara y abre el escáner si se concede.
   * @async
   */
  const handleAbrirCamara = async () => {
    const { status } = await Camera.requestCameraPermissionsAsync();
    setHasCameraPermission(status === 'granted');
    if (status === 'granted') {
      setEscaneando(true);
    } else {
      Alert.alert('Permiso requerido', 'Debes permitir el acceso a la cámara para escanear códigos QR.');
    }
  };

  /**
   * Carga vendedores pendientes desde el backend.
   * @async
   */
  const fetchPendingVendedores = async () => {
    setLoadingPendientes(true);
    try {
      const params = { estado: 'pendiente', limit: 50 };
      if (searchQuery) params.search = searchQuery;
      const response = await vendedoresApi.listar(params);
      setPendientes(response.data || []);
    } catch (error) {
      console.error('Error fetching pending vendedores:', error);
    } finally {
      setLoadingPendientes(false);
    }
  };

  useEffect(() => {
    fetchPendingVendedores();
  }, [searchQuery]);

  /**
   * Ejecuta la validación y registra en historial.
   * @async
   * @param {string} val - Valor a validar.
   */
  const ejecutarValidacion = async (val) => {
    try {
      const found = await validarVendedor(tipoBusqueda, val.trim());
      setHistorial((prev) => [
        {
          nombre: found ? found.nombre : val,
          detalle: found ? (found.categorias || []).map((c) => c.nombre).join(', ') : 'No encontrado',
          resultado: found?.estadoActivo === 'VIGENTE' ? 'vigente' : 'expirado',
          hace: 'hace unos segundos',
        },
        ...prev,
      ].slice(0, 6));
      if (found) {
        setSelectedVendedor(found);
        setValidationData({ estado: 'validado', observaciones: '' });
        setShowValidationModal(true);
      } else {
        Alert.alert('No encontrado', 'No existe un vendedor con ese dato.');
      }
    } catch (err) {
      Alert.alert('Error', getErrorMessage(err));
    }
  };

  /**
   * Maneja el escaneo exitoso de QR.
   * @param {Object} scanningResult
   */
  const handleBarCodeScanned = ({ data }) => {
    setEscaneando(false);
    setTipoBusqueda('qr');
    ejecutarValidacion(data);
  };

  const openValidation = (vendedor) => {
    setSelectedVendedor(vendedor);
    setValidationData({ estado: 'validado', observaciones: '' });
    setShowValidationModal(true);
  };

  const closeValidationModal = () => {
    setShowValidationModal(false);
    setSelectedVendedor(null);
  };

  const handleValidate = async (estado) => {
    if (!selectedVendedor) return;
    try {
      setValidationLoading(true);
      await vendedoresApi.actualizar(selectedVendedor.idVendedor, {
        ...selectedVendedor,
        estadoActivo: estado === 'validado' ? 'VIGENTE' : 'REVOCADA',
        observaciones: validationData.observaciones,
      });
      Alert.alert('Éxito', `Vendedor ${estado === 'validado' ? 'validado' : 'rechazado'} correctamente`);
      closeValidationModal();
      fetchPendingVendedores();
    } catch (error) {
      Alert.alert('Error', getErrorMessage(error));
    } finally {
      setValidationLoading(false);
    }
  };

  // Vista de cámara
  if (escaneando) {
    if (hasCameraPermission === null) {
      return (
        <View style={styles.loading}>
          <ActivityIndicator size="large" color={COLORS.primary} />
          <Text style={styles.loadingText}>Solicitando permiso de cámara...</Text>
        </View>
      );
    }
    if (hasCameraPermission === false) {
      return (
        <View style={styles.loading}>
          <Ionicons name="camera-off" size={48} color={COLORS.gray} />
          <Text style={styles.loadingText}>Se necesita permiso para usar la cámara</Text>
          <TouchableOpacity style={styles.btnBuscar} onPress={handleAbrirCamara}>
            <Text style={styles.btnBuscarTexto}>Conceder permiso</Text>
          </TouchableOpacity>
          <TouchableOpacity style={[styles.btnBuscar, { marginTop: 10, backgroundColor: COLORS.gray }]} onPress={() => setEscaneando(false)}>
            <Text style={styles.btnBuscarTexto}>Cancelar</Text>
          </TouchableOpacity>
        </View>
      );
    }

    return (
      <View style={styles.cameraContainer}>
        <CameraView
          style={styles.camera}
          facing="back"
          barcodeScannerSettings={{ barcodeTypes: ['qr'] }}
          onBarcodeScanned={handleBarCodeScanned}
        >
          <View style={styles.cameraOverlay}>
            <View style={styles.scanFrame} />
            <Text style={styles.cameraHint}>Enfoca el código QR del vendedor</Text>
          </View>
        </CameraView>
        <TouchableOpacity style={styles.cameraCloseBtn} onPress={() => setEscaneando(false)}>
          <Ionicons name="close-circle" size={48} color={COLORS.white} />
        </TouchableOpacity>
      </View>
    );
  }

  return (
    <KeyboardAvoidingView behavior={Platform.OS === 'ios' ? 'padding' : 'height'} style={styles.container}>
      <View style={styles.header}>
        <View style={{ width: 44 }} />
        <Text style={styles.headerTitulo}>Validar Vendedores</Text>
        <TouchableOpacity onPress={clearAuth} style={styles.backBtn}>
          <Ionicons name="log-out-outline" size={24} color={COLORS.danger} />
        </TouchableOpacity>
      </View>

      <ScrollView contentContainerStyle={styles.scrollContent}>
        <View style={styles.scanSection}>
          <Text style={styles.sectionTitle}>Escanear QR</Text>
          <Text style={styles.sectionSubtitle}>Apunta la cámara al código QR del vendedor</Text>
          <TouchableOpacity style={styles.scanArea} onPress={handleAbrirCamara} activeOpacity={0.8}>
            <View style={[styles.scanCorner, { top: 6, left: 6, borderTopWidth: 2, borderLeftWidth: 2 }]} />
            <View style={[styles.scanCorner, { top: 6, right: 6, borderTopWidth: 2, borderRightWidth: 2 }]} />
            <View style={[styles.scanCorner, { bottom: 6, left: 6, borderBottomWidth: 2, borderLeftWidth: 2 }]} />
            <View style={[styles.scanCorner, { bottom: 6, right: 6, borderBottomWidth: 2, borderRightWidth: 2 }]} />
            <Ionicons name="qr-code" size={48} color={COLORS.primary} />
            <Text style={styles.scanTapText}>Toca para abrir la cámara</Text>
          </TouchableOpacity>
          <Text style={styles.scanHint}>— o busca manualmente abajo —</Text>
        </View>

        <View style={styles.searchSection}>
          <Text style={styles.sectionTitle}>Búsqueda Manual</Text>
          <View style={styles.manualRow}>
            <TouchableOpacity
              style={[styles.tipoBtn, tipoBusqueda === 'cedula' && styles.tipoBtnActivo]}
              onPress={() => setTipoBusqueda('cedula')}
            >
              <Text style={[styles.tipoBtnTexto, tipoBusqueda === 'cedula' && styles.tipoBtnTextoActivo]}>Cédula</Text>
            </TouchableOpacity>
          </View>
          <TextInput
            style={styles.searchInput}
            placeholder= 'Buscar por cédula, nombre...'
            value={searchQuery}
            onChangeText={setSearchQuery}
          />
          <TouchableOpacity style={styles.btnBuscar} onPress={() => ejecutarValidacion(searchQuery)}>
            <Text style={styles.btnBuscarTexto}>Buscar</Text>
          </TouchableOpacity>
        </View>

        <View style={styles.historialSection}>
          <View style={styles.sectionHeader}>
            <Text style={styles.sectionTitle}>Historial de Verificaciones</Text>
          </View>
          {historial.length === 0 ? (
            <Text style={styles.emptyHist}>Sin verificaciones aún.</Text>
          ) : (
            historial.map((h, i) => (
              <View key={i} style={styles.histItem}>
                <View style={styles.histRow}>
                  <View style={styles.histAvatar}>
                    <View style={[styles.avatar, { backgroundColor: getAvatarColors(h.nombre).bg }]}>
                      <Text style={[styles.avatarText, { color: getAvatarColors(h.nombre).color }]}>{getInitials(h.nombre)}</Text>
                    </View>
                    <Text style={styles.histNombre}>{h.nombre}</Text>
                  </View>
                  {h.resultado === 'vigente' ? (
                    <View style={styles.badgeOk}>
                      <Ionicons name="check" size={10} color={COLORS.success} />
                      <Text style={styles.badgeTexto}>Vigente</Text>
                    </View>
                  ) : (
                    <View style={styles.badgeErr}>
                      <Ionicons name="close" size={10} color={COLORS.danger} />
                      <Text style={[styles.badgeTexto, { color: COLORS.danger }]}>Expirado</Text>
                    </View>
                  )}
                </View>
                <Text style={styles.histDetalle}>{h.hace} · {h.detalle}</Text>
              </View>
            ))
          )}
        </View>

        <View style={styles.pendientesSection}>
          <Text style={styles.sectionTitle}>Vendedores Pendientes de Validación</Text>
          {loadingPendientes ? (
            <ActivityIndicator size="small" color={COLORS.primary} />
          ) : pendientes.length === 0 ? (
            <View style={styles.emptyState}>
              <Ionicons name="checkmark-circle" size={64} color={COLORS.primary} />
              <Text style={styles.emptyTitle}>Sin vendedores pendientes</Text>
              <Text style={styles.emptyText}>Todos los vendedores han sido validados</Text>
            </View>
          ) : (
            pendientes.map((v) => (
              <TouchableOpacity key={v.idVendedor} style={styles.pendienteRow} onPress={() => openValidation(v)}>
                <View style={[styles.avatar, { backgroundColor: getAvatarColors(v.nombre).bg }]}>
                  <Text style={[styles.avatarText, { color: getAvatarColors(v.nombre).color }]}>{getInitials(v.nombre)}</Text>
                </View>
                <View style={styles.pendienteInfo}>
                  <Text style={styles.pendienteNombre}>{v.nombre}</Text>
                  <Text style={styles.pendienteCedula}>{v.cedula}</Text>
                </View>
                <Ionicons name="chevron-forward" size={20} color={COLORS.gray} />
              </TouchableOpacity>
            ))
          )}
        </View>
      </ScrollView>

      <Modal visible={showValidationModal} animationType="slide" transparent={true} onRequestClose={closeValidationModal}>
        {selectedVendedor && (
          <KeyboardAvoidingView behavior={Platform.OS === 'ios' ? 'padding' : 'height'} style={styles.modalContainer}>
            <View style={styles.modalContent}>
              <View style={styles.vendedorPreview}>
                <View style={styles.vendedorAvatarLarge}>
                  <View style={[styles.avatarLarge, { backgroundColor: getAvatarColors(selectedVendedor.nombre).bg }]}>
                    <Text style={[styles.avatarTextLarge, { color: getAvatarColors(selectedVendedor.nombre).color }]}>{getInitials(selectedVendedor.nombre)}</Text>
                  </View>
                </View>
                <View style={styles.previewInfo}>
                  <Text style={styles.previewTitle}>{selectedVendedor.nombre} {selectedVendedor.apellidos || ''}</Text>
                  <Text style={styles.previewEmail}>{selectedVendedor.email}</Text>
                  <Text style={styles.previewPhone}>{selectedVendedor.telefono || 'Sin teléfono'}</Text>
                  <Text style={styles.previewDni}>DNI: {selectedVendedor.dni || 'N/A'}</Text>
                  <Text style={styles.previewDireccion}>Dirección: {selectedVendedor.direccion || 'N/A'}</Text>
                </View>
              </View>

              <View style={styles.section}>
                <Text style={styles.sectionTitle}>Acción de Validación</Text>
                <View style={styles.radioGroup}>
                  <TouchableOpacity
                    style={[styles.radioButton, validationData.estado === 'validado' && styles.radioButtonSelected]}
                    onPress={() => setValidationData({ ...validationData, estado: 'validado' })}
                  >
                    <View style={[styles.radioCircle, validationData.estado === 'validado' && styles.radioCircleSelected]} />
                    <Text style={[styles.radioLabel, validationData.estado === 'validado' && styles.radioLabelSelected]}>Validar</Text>
                  </TouchableOpacity>
                  <TouchableOpacity
                    style={[styles.radioButton, validationData.estado === 'rechazado' && styles.radioButtonSelected]}
                    onPress={() => setValidationData({ ...validationData, estado: 'rechazado' })}
                  >
                    <View style={[styles.radioCircle, validationData.estado === 'rechazado' && styles.radioCircleSelected]} />
                    <Text style={[styles.radioLabel, validationData.estado === 'rechazado' && styles.radioLabelSelected]}>Rechazar</Text>
                  </TouchableOpacity>
                </View>
              </View>

              <View style={styles.section}>
                <Text style={styles.sectionTitle}>Observaciones</Text>
                <TextInput
                  style={styles.modalInput}
                  placeholder="Observaciones opcionales..."
                  value={validationData.observaciones}
                  onChangeText={(value) => setValidationData({ ...validationData, observaciones: value })}
                  multiline
                  numberOfLines={3}
                />
              </View>

              <View style={styles.modalActions}>
                <TouchableOpacity style={styles.btnCancelar} onPress={closeValidationModal} disabled={validationLoading}>
                  <Text style={styles.btnCancelarTexto}>Cancelar</Text>
                </TouchableOpacity>
                <TouchableOpacity
                  style={[styles.btnConfirmar, validationData.estado === 'validado' ? styles.btnConfirmarPrimario : styles.btnConfirmarPeligro]}
                  onPress={() => handleValidate(validationData.estado)}
                  disabled={validationLoading}
                >
                  <Text style={styles.btnConfirmarTexto}>
                    {validationLoading ? 'Procesando…' : (validationData.estado === 'validado' ? 'Validar Vendedor' : 'Rechazar Vendedor')}
                  </Text>
                </TouchableOpacity>
              </View>
            </View>
          </KeyboardAvoidingView>
        )}
      </Modal>
    </KeyboardAvoidingView>
  );
}

const styles = StyleSheet.create({
