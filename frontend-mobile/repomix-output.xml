/**
 * @fileoverview Dashboard principal con estadísticas y accesos rápidos.
 * Muestra conteos de vehículos, vendedores, categorías y lista reciente.
 * @module pantallas/Dashboard
 */

import React, { useEffect, useState } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, ActivityIndicator } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { useAppData } from '../gatillos/useAppData';
import { colorHexDe } from '../utilidades/uiOptions';
import { COLORS } from '../utilidades/config';

/**
 * Pantalla de inicio con métricas y navegación rápida.
 * @param {Object} props
 * @param {Object} props.navigation - Navegación de React Navigation.
 * @returns {JSX.Element}
 */
export default function Dashboard({ navigation }) {
  const { 
    vehiculos, 
    vendedores, 
    categorias, 
    vehiculosLoading, 
    vendedoresLoading, 
    categoriasLoading, 
    fetchVehiculos, 
    fetchVendedores, 
    fetchCategorias 
  } = useAppData();

  const [refreshing, setRefreshing] = useState(false);

  /** Carga inicial de datos al montar el componente. */
  useEffect(() => {
    fetchVehiculos(1);
    fetchVendedores(1);
    fetchCategorias(1);
  }, [fetchVehiculos, fetchVendedores, fetchCategorias]);

  /**
   * Refresca manualmente los tres conjuntos de datos.
   * Mantiene el spinner al menos 1 segundo para feedback visual.
   */
  const onRefresh = () => {
    setRefreshing(true);
    fetchVehiculos(1);
    fetchVendedores(1);
    fetchCategorias(1);
    setTimeout(() => setRefreshing(false), 1000);
  };

  const vigentes = vehiculos.filter(v => v.estadoActivo === 'VIGENTE').length;
  const revocados = vehiculos.filter(v => v.estadoActivo !== 'VIGENTE').length;

  if (vehiculosLoading || vendedoresLoading || categoriasLoading) {
    return (
      <View style={styles.loading}>
        <ActivityIndicator size="large" color={COLORS.primary} />
        <Text style={styles.loadingText}>Cargando...</Text>
      </View>
    );
  }

  return (
    <View style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.titulo}>Dashboard</Text>
      </View>

      <View style={styles.statsGrid}>
        <View style={[styles.statCard, { borderColor: COLORS.primary }]}>
          <Text style={styles.statNumero}>{vehiculos.length}</Text>
          <Text style={styles.statLabel}>Total Vehículos</Text>
        </View>
        <View style={[styles.statCard, { borderColor: COLORS.success }]}>
          <Text style={[styles.statNumero, { color: COLORS.success }]}>{vigentes}</Text>
          <Text style={styles.statLabel}>Vigentes</Text>
        </View>
        <View style={[styles.statCard, { borderColor: COLORS.danger }]}>
          <Text style={[styles.statNumero, { color: COLORS.danger }]}>{revocados}</Text>
          <Text style={styles.statLabel}>Revocados</Text>
        </View>
        <View style={[styles.statCard, { borderColor: '#0ea5e9' }]}>
          <Text style={[styles.statNumero, { color: '#0ea5e9' }]}>{vendedores.length}</Text>
          <Text style={styles.statLabel}>Vendedores</Text>
        </View>
        <View style={[styles.statCard, { borderColor: '#8b5cf6' }]}>
          <Text style={[styles.statNumero, { color: '#8b5cf6' }]}>{categorias.length}</Text>
          <Text style={styles.statLabel}>Categorías</Text>
        </View>
      </View>

      <View style={styles.quickActions}>
        <Text style={styles.sectionTitle}>Accesos Rápidos</Text>
        <View style={styles.actionsGrid}>
          <TouchableOpacity style={[styles.actionCard, { borderColor: COLORS.primary }]} onPress={() => navigation.navigate('Validar')}>
            <Ionicons name="qr-code" size={28} color={COLORS.primary} />
            <Text style={{ color: COLORS.primary }}>Validar Vehículo</Text>
          </TouchableOpacity>
          <TouchableOpacity style={[styles.actionCard, { borderColor: '#0ea5e9' }]} onPress={() => navigation.navigate('Validar')}>
            <Ionicons name="person-add" size={28} color="#0ea5e9" />
            <Text style={{ color: '#0ea5e9' }}>Validar Vendedor</Text>
          </TouchableOpacity>
          <TouchableOpacity style={[styles.actionCard, { borderColor: '#22c55e' }]} onPress={() => navigation.navigate('VehiculoFormulario')}>
            <Ionicons name="add-circle" size={28} color="#22c55e" />
            <Text style={{ color: '#22c55e' }}>Nuevo Vehículo</Text>
          </TouchableOpacity>
          <TouchableOpacity style={[styles.actionCard, { borderColor: '#8b5cf6' }]} onPress={() => navigation.navigate('Reportes')}>
            <Ionicons name="document-text" size={28} color="#8b5cf6" />
            <Text style={{ color: '#8b5cf6' }}>Ver Reportes</Text>
          </TouchableOpacity>
        </View>
      </View>

      <View style={styles.recentSection}>
        <View style={styles.sectionHeader}>
          <Text style={styles.sectionTitle}>Vehículos Recientes</Text>
          <TouchableOpacity onPress={() => navigation.navigate('Vehiculos')}>
            <Text style={styles.verTodos}>Ver todos</Text>
          </TouchableOpacity>
        </View>
        {vehiculos.slice(0, 5).map(v => (
          <View key={v.idVehiculo} style={styles.recentItem}>
            <View style={[styles.recentIcon, { backgroundColor: colorHexDe(v.color) + '20' }]}>
              <Ionicons name="car" size={24} color={colorHexDe(v.color)} />
            </View>
            <View style={styles.recentInfo}>
              <Text style={styles.recentTitle}>{v.marca} {v.modelo}</Text>
