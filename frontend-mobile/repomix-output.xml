/**
 * @fileoverview Listado paginado de categorías con búsqueda y desactivación.
 * @module pantallas/CategoriasLista
 */

import React, { useEffect, useState } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, FlatList, ActivityIndicator, TextInput, Alert } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { useAppData } from '../gatillos/useAppData';
import { COLORS } from '../utilidades/config';

/**
 * Pantalla de gestión de categorías.
 * @param {Object} props
 * @param {Object} props.navigation - Navegación.
 * @returns {JSX.Element}
 */
export default function CategoriasLista({ navigation }) {
  const { 
    categorias, 
    categoriasMeta, 
    categoriasPage, 
    categoriasLoading, 
    fetchCategorias, 
    desactivarCategoria 
  } = useAppData();
  const [searchQuery, setSearchQuery] = useState('');

  /** Filtra categorías por nombre en la página actual. */
  const visibles = categorias.filter(c => 
    c.nombre.toLowerCase().includes(searchQuery.toLowerCase())
  );

  /** Carga inicial. */
  useEffect(() => {
    fetchCategorias(1);
  }, [fetchCategorias]);

  /**
   * Cambia de página.
   * @param {number} page - Página destino.
   */
  const handlePageChange = (page) => {
    fetchCategorias(page);
  };

  /**
   * Muestra alerta de confirmación antes de desactivar.
   * @param {Object} categoria - Categoría a desactivar.
   */
  const handleEliminar = (categoria) => {
    Alert.alert('Confirmar', '¿Desactivar esta categoría?', [
      { text: 'Cancelar', style: 'cancel' },
      { text: 'Desactivar', style: 'destructive', onPress: async () => {
        try {
          await desactivarCategoria(categoria);
        } catch (error) {
          Alert.alert('Error', 'Error al desactivar');
        }
      }}
    ]);
  };

  if (categoriasLoading && categoriasPage === 1) {
    return (
      <View style={styles.loading}>
        <ActivityIndicator size="large" color={COLORS.primary} />
        <Text style={styles.loadingText}>Cargando categorías...</Text>
      </View>
    );
  }

  return (
    <View style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.titulo}>Gestión de Categorías</Text>
        <TouchableOpacity style={styles.btnNuevo} onPress={() => navigation.navigate('CategoriaFormulario')}>
          <Ionicons name="add" size={20} color={COLORS.white} style={{ marginRight: 6 }} />
          <Text style={styles.btnNuevoTexto}>Nueva</Text>
        </TouchableOpacity>
      </View>

      <View style={styles.searchRow}>
        <TextInput
          style={styles.searchInput}
          placeholder="Buscar categorías..."
          value={searchQuery}
          onChangeText={setSearchQuery}
        />
      </View>

      <FlatList
        data={visibles}
        keyExtractor={(item) => item.idCategoria.toString()}
        renderItem={({ item }) => (
          <TouchableOpacity style={styles.row} onPress={() => navigation.navigate('CategoriaFormulario', { item })}>
            <View style={styles.cellIcon}>
              <Ionicons name="tag" size={24} color={COLORS.primary} />
            </View>
            <View style={styles.cellInfo}>
              <Text style={styles.cellNombre}>{item.nombre}</Text>
              {item.descripcion ? <Text style={styles.cellDesc}>{item.descripcion}</Text> : null}
            </View>
            <View style={styles.cellCount}>
              <Text style={styles.cellCountText}>{item.vehiculos_count || 0} vehículos</Text>
            </View>
            <View style={styles.cellAcciones}>
              <TouchableOpacity onPress={() => handleEliminar(item)} style={styles.actionBtn}>
                <Ionicons name="trash" size={20} color={COLORS.danger} />
              </TouchableOpacity>
            </View>
          </TouchableOpacity>
        )}
        contentContainerStyle={styles.listContent}
        ListEmptyComponent={
          <View style={styles.emptyState}>
            <Ionicons name="grid-off" size={64} color={COLORS.gray} />
            <Text style={styles.emptyText}>No hay categorías</Text>
          </View>
        }
      />

      {categoriasMeta && categoriasMeta.totalPages > 1 && (
        <View style={styles.pager}>
          <Text style={styles.pagerText}>
            {categoriasMeta ? `Página ${categoriasMeta.currentPage} de ${categoriasMeta.totalPages} · Total ${categoriasMeta.totalItems}` : '—'}
          </Text>
          <View style={styles.pagerButtons}>
            <TouchableOpacity style={[styles.pagerBtn, !categoriasMeta?.prevPage && styles.pagerBtnDisabled]} onPress={() => handlePageChange(categoriasPage - 1)} disabled={!categoriasMeta?.prevPage}>
              <Text style={styles.pagerBtnText}>← Anterior</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[styles.pagerBtn, styles.pagerBtnActive]}>
              <Text style={[styles.pagerBtnText, { color: COLORS.white }]}>{categoriasPage}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[styles.pagerBtn, !categoriasMeta?.nextPage && styles.pagerBtnDisabled]} onPress={() => handlePageChange(categoriasPage + 1)} disabled={!categoriasMeta?.nextPage}>
              <Text style={styles.pagerBtnText}>Siguiente →</Text>
            </TouchableOpacity>
          </View>
        </View>
      )}
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: COLORS.background },
  header: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: 16, borderBottomWidth: 1, borderBottomColor: COLORS.border },
  titulo: { fontSize: 20, fontWeight: '700', color: COLORS.text },
  btnNuevo: { flexDirection: 'row', alignItems: 'center', gap: 6, paddingHorizontal: 12, paddingVertical: 8, borderRadius: 8, backgroundColor: COLORS.primary },
  btnNuevoTexto: { fontSize: 13, fontWeight: '600', color: COLORS.white },
  loading: { flex: 1, justifyContent: 'center', alignItems: 'center' },
  loadingText: { marginTop: 12, color: COLORS.gray },
  searchRow: { padding: 16, borderBottomWidth: 0.5, borderBottomColor: COLORS.border },
  searchInput: { height: 40, borderWidth: 1, borderColor: COLORS.border, borderRadius: 8, paddingHorizontal: 12, fontSize: 14, backgroundColor: COLORS.background, color: COLORS.text },
  row: { flexDirection: 'row', paddingHorizontal: 12, paddingVertical: 12, borderBottomWidth: 0.5, borderBottomColor: COLORS.border, alignItems: 'center' },
  cellIcon: { width: 56, height: 56, borderRadius: 12, backgroundColor: '#fef3c7', justifyContent: 'center', alignItems: 'center', marginRight: 12 },
  cellInfo: { flex: 1 },
  cellNombre: { fontSize: 14, fontWeight: '600', color: COLORS.text },
  cellDesc: { fontSize: 12, color: COLORS.gray, marginTop: 2 },
  cellCount: { width: 80, alignItems: 'center' },
  cellCountText: { fontSize: 12, color: COLORS.gray },
  cellAcciones: { width: 40, alignItems: 'center' },
  actionBtn: { padding: 8 },
  listContent: { paddingBottom: 20 },
  emptyState: { flex: 1, justifyContent: 'center', alignItems: 'center', padding: 24 },
  emptyText: { marginTop: 12, fontSize: 14, color: COLORS.gray },
  pager: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: 12, backgroundColor: COLORS.background, borderTopWidth: 0.5, borderTopColor: COLORS.border },
  pagerText: { fontSize: 11, color: COLORS.gray },
  pagerButtons: { flexDirection: 'row', gap: 4 },
  pagerBtn: { height: 28, paddingHorizontal: 12, borderRadius: 8, borderWidth: 1, borderColor: COLORS.border, backgroundColor: COLORS.white, justifyContent: 'center' },
  pagerBtnActive: { backgroundColor: COLORS.primary, borderColor: COLORS.primary },
  pagerBtnDisabled: { opacity: 0.4 },
  pagerBtnText: { fontSize: 11, color: COLORS.gray },
});
